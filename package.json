{
  "name": "cpathportal-anonymizer",
  "version": "1.0.0",
  "private": true,
  "description": "Anonymize whole-slide images in the browser and save them to the user's own machine. Nothing is uploaded.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "node server/server.mjs",
    "set-password": "node server/set-password.mjs",
    "accounts": "node server/manage-accounts.mjs",
    "build:cli": "node cli/build.mjs",
    "build:cli-exe": "node cli/build.mjs --exe"
  },
  "dependencies": {
    "@empaia/wsi-anon": "file:vendor/wsi-anon",
    "@tesseract.js-data/eng": "^1.0.0",
    "pinia": "^2.2.2",
    "primeicons": "^7.0.0",
    "primevue": "^3.53.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "typescript": "~5.5.4",
    "vite": "^5.4.3",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
